{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "preserve",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "baseUrl": ".",
    "paths": {
      "@formx/core": ["packages/core/src"],
      "@formx/ui-core": ["packages/ui-core/src"],
      "@formx/vue-core": ["packages/vue-core/src"],
      "@formx/vue-ep": ["packages/vue-ep/src"],
      "@formx/vue": ["packages/vue/src"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "examples/**/*.ts", "examples/**/*.tsx", "examples/**/*.vue"],
  "exclude": ["node_modules", "**/dist"]
}
