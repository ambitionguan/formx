    "@vue/tsconfig": "^0.5.1",
    "typescript": "5.3.3",
    "tsup": "^8.3.5",
    "vite": "^5.4.20",
    "vitest": "^3.2.4",
    "vue-tsc": "^1.8.27"
  }
}
