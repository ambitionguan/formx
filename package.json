{
  "name": "formx",
  "version": "0.1.0",
  "description": "Headless dynamic form engine for complex business applications.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/formxjs/formx.git"
  },
  "bugs": {
    "url": "https://github.com/formxjs/formx/issues"
  },
  "homepage": "https://github.com/formxjs/formx#readme",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.8.1"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter @formx/example-vue-ep-basic dev",
    "clean": "pnpm -r --filter './packages/*' clean"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "tsup": "^8.3.5",
    "typescript": "5.9.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.7"
  }
}
