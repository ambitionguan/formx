{
  "name": "@formxjs/core",
  "version": "0.1.0",
  "description": "Headless dynamic form engine for FormX.",
  "license": "MIT",
  "keywords": ["formx", "dynamic-form", "headless", "schema", "validation", "low-code"],
  "homepage": "https://github.com/ambitionguan/formx#readme",
  "bugs": {
    "url": "https://github.com/ambitionguan/formx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambitionguan/formx.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "aidl", "src/demo", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./aidl/formx-aidsl.schema.json": "./aidl/formx-aidsl.schema.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  }
}
