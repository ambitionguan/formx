{
  "name": "@formxjs/vue-core",
  "version": "0.1.1",
  "description": "Vue runtime bridge for FormX.",
  "license": "MIT",
  "keywords": ["formx", "dynamic-form", "vue", "runtime", "schema"],
  "homepage": "https://github.com/ambitionguan/formx#readme",
  "bugs": {
    "url": "https://github.com/ambitionguan/formx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambitionguan/formx.git",
    "directory": "packages/vue-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --external vue --external @formxjs/core --external @formxjs/ui-core",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@formxjs/core": "^0.1.1",
    "@formxjs/ui-core": "^0.1.1",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@formxjs/core": "^0.1.1",
    "@formxjs/ui-core": "^0.1.1",
    "vue": "^3.5.22"
  }
}
