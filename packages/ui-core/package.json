{
  "name": "@formxjs/ui-core",
  "version": "0.1.1",
  "description": "Framework-neutral FormX view model and UI protocol.",
  "license": "MIT",
  "keywords": ["formx", "dynamic-form", "view-model", "schema", "ui-protocol"],
  "homepage": "https://github.com/ambitionguan/formx#readme",
  "bugs": {
    "url": "https://github.com/ambitionguan/formx/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambitionguan/formx.git",
    "directory": "packages/ui-core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --external @formxjs/core",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@formxjs/core": "^0.1.1"
  },
  "devDependencies": {
    "@formxjs/core": "^0.1.1"
  }
}
